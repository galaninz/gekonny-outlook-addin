<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>8c24b7e1-9a53-4d76-b0e8-15f7d2c94a63</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Gekonny</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="GK Probe C"/>
  <Description DefaultValue="Diagnostic stub C."/>
  <IconUrl DefaultValue="https://zakhargalan.in/gekonny-outlook-addin/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://zakhargalan.in/gekonny-outlook-addin/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://zakhargalan.in/gekonny-outlook-addin/"/>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://zakhargalan.in/gekonny-outlook-addin/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="gkProbeCGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="gkProbeCButton">
                  <Label resid="Btn.Label"/>
                  <Supertip>
                    <Title resid="Btn.Label"/>
                    <Description resid="Btn.Tip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://zakhargalan.in/gekonny-outlook-addin/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://zakhargalan.in/gekonny-outlook-addin/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://zakhargalan.in/gekonny-outlook-addin/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://zakhargalan.in/gekonny-outlook-addin/taskpane.html"/>
        <bt:Url id="Commands.Url" DefaultValue="https://zakhargalan.in/gekonny-outlook-addin/commands.html"/>
        <bt:Url id="WebViewRuntime.Url" DefaultValue="https://zakhargalan.in/gekonny-outlook-addin/commands.html"/>
        <bt:Url id="JSRuntime.Url" DefaultValue="https://zakhargalan.in/gekonny-outlook-addin/commands.js"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="GK C"/>
        <bt:String id="Btn.Label" DefaultValue="Probe C"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Btn.Tip" DefaultValue="Diagnostic stub C."/>
      </bt:LongStrings>
    </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
